<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). The two layers are generated by
  tools/gen_icon.cs — see docs/PLATFORMS.md. Keeping them as raster layers
  instead of a <vector> keeps the artwork identical across densities and lets
  the same drawing code produce the legacy full-bleed PNGs.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
